# Air Quality Intelligence Platform - Airflow Worker/Scheduler Service
# Multi-stage build for optimized production image

# ============================================================================
# BUILDER STAGE: Compile dependencies
# ============================================================================
FROM python:3.12.1-slim-bookworm as builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for build
RUN groupadd -r aqworker && useradd -r -g aqworker aqworker

WORKDIR /build
RUN chown -R aqworker:aqworker /build

USER aqworker

# Copy and install dependencies
COPY pyproject.toml ./
RUN pip install --user --no-warn-script-location -e .

# ============================================================================
# RUNTIME STAGE: Minimal production image
# ============================================================================
FROM python:3.12.1-slim-bookworm

LABEL maintainer="Air Quality Engineering Team" \
      description="Airflow scheduler/worker for Air Quality Intelligence Platform" \
      version="0.1.0"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    AIRFLOW__CORE__LOAD_EXAMPLES=False \
    AIRFLOW__CORE__UNIT_TEST_MODE=False \
    AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True

# Install runtime dependencies including Airflow-specific tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r aqworker && useradd -r -g aqworker aqworker

WORKDIR /app
RUN chown -R aqworker:aqworker /app

USER aqworker

# Copy Python dependencies from builder
COPY --from=builder --chown=aqworker:aqworker /root/.local /home/aqworker/.local

# Copy application source and DAGs
COPY --chown=aqworker:aqworker src/ /app/src/
COPY --chown=aqworker:aqworker dags/ /app/dags/
COPY --chown=aqworker:aqworker configs/ /app/configs/

ENV PATH=/home/aqworker/.local/bin:$PATH

# Health check: verify Airflow can access database
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD airflow jobs check-sla > /dev/null 2>&1 || exit 1

# Default command: start airflow scheduler
# Can be overridden to run worker, webserver, or shell
CMD ["airflow", "scheduler"]
