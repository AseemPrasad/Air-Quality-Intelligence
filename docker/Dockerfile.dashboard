# Air Quality Intelligence Platform - Streamlit Dashboard Service
# Multi-stage build for optimized production image

# ============================================================================
# BUILDER STAGE: Compile dependencies
# ============================================================================
FROM python:3.12.1-slim-bookworm as builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for build
RUN groupadd -r aqworker && useradd -r -g aqworker aqworker

WORKDIR /build
RUN chown -R aqworker:aqworker /build

USER aqworker

# Copy and install dependencies
COPY pyproject.toml ./
RUN pip install --user --no-warn-script-location -e .

# ============================================================================
# RUNTIME STAGE: Minimal production image
# ============================================================================
FROM python:3.12.1-slim-bookworm

LABEL maintainer="Air Quality Engineering Team" \
      description="Streamlit dashboard for Air Quality Intelligence Platform" \
      version="0.1.0"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_LOGGER_LEVEL=info

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r aqworker && useradd -r -g aqworker aqworker

WORKDIR /app
RUN chown -R aqworker:aqworker /app

USER aqworker

# Copy Python dependencies from builder
COPY --from=builder --chown=aqworker:aqworker /root/.local /home/aqworker/.local

# Copy application source
COPY --chown=aqworker:aqworker src/ /app/src/
COPY --chown=aqworker:aqworker configs/ /app/configs/

ENV PATH=/home/aqworker/.local/bin:$PATH

EXPOSE 8501

# Health check: verify Streamlit responds
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "src/aq_engine/dashboard/app.py"]
