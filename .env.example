# =============================================================================
# Air Quality Intelligence Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment
# IMPORTANT: Never commit .env with real secrets to version control

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=aqadmin
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aq_control

# Connection string for applications (optional, generated from above if not set)
# DATABASE_URL=postgresql+psycopg://aqadmin:changeme@postgres:5432/aq_control

# =============================================================================
# AIRFLOW CONFIGURATION
# =============================================================================
AIRFLOW_HOME=/airflow
AIRFLOW__CORE__DAGS_FOLDER=/app/dags
AIRFLOW__CORE__BASE_LOG_FOLDER=/app/logs
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__UNIT_TEST_MODE=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg://aqadmin:changeme@postgres:5432/aq_control

# Default Airflow credentials (change in production)
AIRFLOW_UID=50000
AIRFLOW_GID=50000

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_LOG_LEVEL=INFO

# =============================================================================
# DASHBOARD CONFIGURATION
# =============================================================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
API_URL=http://api:8000
DASHBOARD_LOG_LEVEL=INFO

# =============================================================================
# DATA SOURCES - API KEYS
# =============================================================================
# OpenAQ API Key
OPENAQ_API_KEY=your_openaq_api_key_here

# Open-Meteo does not require an API key
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# FEATURE FLAGS & RUNTIME OPTIONS
# =============================================================================
DEBUG=False
ENVIRONMENT=development
VERSION=0.1.0

# =============================================================================
# DATA RETENTION POLICIES
# =============================================================================
# Lookback window for late arrivals (hours)
DATA_LATE_ARRIVAL_LOOKBACK_HOURS=6
# Historical data retention (days)
DATA_RETENTION_DAYS=730
